# Copy this file to .env and adjust as needed.
# Everything here is optional - these are the defaults if unset.

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1

VIENNA_WFS_URL=https://data.wien.gv.at/daten/geo

# Usually you won't need to touch these - they default to sensible
# locations relative to the project root. Override only if you need to
# point at a different machine's data/model directories (e.g. in a
# container, or a shared model volume).
# RUNTIME_DATA_DIR=./data/runtime
# MODEL_DIR=./models
# BEV_GPKG_PATH=./data/bev_bauwerke_vienna.gpkg
